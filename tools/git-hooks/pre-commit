#!/usr/bin/env bash
# Enabled by link.sh. Run relevant checks; keep successful output compact.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only)
changed() { grep -Eq "^tools/git-hooks/pre-commit$|$1" <<< "$staged"; }
log=$(mktemp "${TMPDIR:-/tmp}/singularity-check.XXXXXX")
trap 'rm -f -- "$log"' EXIT

run() {
    if "$@" >"$log" 2>&1; then
        echo "PASS $*"
    else
        cat "$log"
        echo "FAIL $*" >&2
        exit 1
    fi
}

if changed 'quickshell/settings/|services/SettingsIndex\.js$|^tools/check-settings-index\.py$'; then
    run python3 tools/check-settings-index.py
fi

if changed 'quickshell/.*\.(qml|js)$|^tools/check-unused\.py$'; then
    run python3 tools/check-unused.py
fi

if changed 'quickshell/services/.*\.js$|services/(SystemStats|Files|Apps)\.qml$|tools/(test-js|merge-binds)\.mjs$|hypr/\.config/hypr/.*\.lua$|binds\.defaults\.lua$|singularity/autostart\.sh$'; then
    run node --test tools/test-js.mjs
fi

if changed 'services/(Settings\.qml|SettingsValues\.js)$|tools/(test-settings|qml-harness)\.mjs$'; then
    run node --test tools/test-settings.mjs
fi

if changed 'quickshell/(sidebar/AiSidebar|AiHost)\.qml$|services/(AtomicFileWrite|Files|Ai|AiSession|ClaudeSession|CodexSession)\.qml$|tools/(test-processes|qml-harness)\.mjs$'; then
    run node --test tools/test-processes.mjs
fi

if changed 'quickshell/(scripts/ai_host\.py|AiHost\.qml|services/(Ai|Notifications)\.qml)$|^tools/test-(ai-host\.py|notification-routing\.mjs)$'; then
    run python3 tools/test-ai-host.py
    run node --test tools/test-notification-routing.mjs
fi

if changed 'quickshell/scripts/ollama-agent\.py$|^tools/test-ollama-agent\.py$'; then
    run python3 tools/test-ollama-agent.py
fi

if changed '^tools/(ollama-status|test-ollama-status)\.py$'; then
    run python3 tools/test-ollama-status.py
fi

if changed 'state-paths\.py$|^link\.sh$|hypr/autostart\.lua$|quickshell/services/Paths\.qml$'; then
    run python3 tools/test-state-paths.py
fi

if changed '^(packages/|scripts/(hardware|lib)\.sh$|install\.sh$|update\.sh$|tools/check-hardware\.sh$)|singularity/(platform\.sh|profiles/)'; then
    run tools/check-hardware.sh
fi

if changed '^(scripts/hardware\.sh|install\.sh|link\.sh|update\.sh|tools/test-platform\.py)$|singularity/(platform\.sh|profiles/)|hypr/platform\.lua$'; then
    run python3 tools/test-platform.py
fi

if changed '^tools/(context|check-syntax|check-unused|test-tools)\.py$'; then
    run python3 tools/test-tools.py
fi

if changed '\.(sh|py|lua)$|^system/usr/local/lib/singularity/'; then
    run python3 tools/check-syntax.py
fi
