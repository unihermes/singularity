#!/usr/bin/env bash
# Enabled by link.sh (git config core.hooksPath tools/git-hooks).
#
# Settings search is a hand-written index; when a Settings page or the index
# itself is part of a commit, make sure the two still agree.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only)
changed() { grep -Eq "^tools/git-hooks/pre-commit$|$1" <<< "$staged"; }

if changed 'quickshell/settings/|services/SettingsIndex\.js$|^tools/check-settings-index\.py$'; then
    if ! python3 tools/check-settings-index.py; then
        echo
        echo "Settings search index is out of step with the pages (above)."
        echo "Fix services/SettingsIndex.js, or add a reasoned ALLOW entry in"
        echo "tools/check-settings-index.py. git commit --no-verify skips this."
        exit 1
    fi
fi

# Declarations nothing reads, in the shell's QML and JS (check-unused.py).
if changed 'quickshell/.*\.(qml|js)$|^tools/check-unused\.py$'; then
    if ! python3 tools/check-unused.py; then
        echo
        echo "Something in the shell is declared and never read (above)."
        echo "Remove it, or add a reasoned ALLOW entry in tools/check-unused.py."
        echo "git commit --no-verify skips this."
        exit 1
    fi
fi

# The plain-JS modules' tests, when one of them or the tests are staged
# (test-js.mjs also reads the Hyprland modules, so they count too).
if changed 'quickshell/services/.*\.js$|tools/(test-js|merge-binds)\.mjs$|hypr/\.config/hypr/.*\.lua$|binds\.defaults\.lua$'; then
    test_log=$(mktemp "${TMPDIR:-/tmp}/singularity-test-js.XXXXXX")
    trap 'rm -f -- "$test_log"' EXIT
    if ! node --test tools/test-js.mjs >"$test_log" 2>&1; then
        cat "$test_log"
        echo
        echo "JS module tests failed (full output above)."
        echo "git commit --no-verify skips this."
        exit 1
    fi
fi

# The sidebar host's launcher and the notification routing to it.
if changed 'quickshell/(scripts/ai_host\.py|AiHost\.qml|services/(Ai|Notifications)\.qml)$|^tools/test-(ai-host\.py|notification-routing\.mjs)$'; then
    python3 tools/test-ai-host.py
    node --test tools/test-notification-routing.mjs
fi

# The package lists against hardware.sh's capabilities (check-hardware.sh).
if changed '^(packages/|hardware\.sh$|lib\.sh$|install\.sh$|update\.sh$|tools/check-hardware\.sh$)|singularity/(platform\.sh|profiles/)'; then
    if ! tools/check-hardware.sh; then
        echo
        echo "packages/ and hardware.sh disagree (above). A list in packages/hardware/"
        echo "needs a capability of the same name in hardware.sh's has() and hw_caps."
        echo "git commit --no-verify skips this."
        exit 1
    fi
fi

# Selection and runtime gates share a policy and hardware resolver.
if changed '^(hardware\.sh|install\.sh|link\.sh|update\.sh|tools/test-platform\.py)$|singularity/(platform\.sh|profiles/)|hypr/platform\.lua$'; then
    python3 tools/test-platform.py
fi

# Repository discovery and check selection.
if changed '^tools/(context|check-syntax|check-unused|test-tools)\.py$'; then
    python3 tools/test-tools.py
fi

if changed '\.(sh|py|lua)$|^system/usr/local/bin/'; then
    python3 tools/check-syntax.py
fi
