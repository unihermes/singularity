# Singularity - Floorp hitch monitor
#
# Logs Floorp's long main-thread and renderer stalls, with what else was going
# on, to ~/.local/state/singularity/floorp-watch.jsonl; `floorp-watch report`
# summarises them. It sleeps while Floorp isn't running.
[Unit]
Description=Floorp hitch monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/floorp-watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
