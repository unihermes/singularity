    ProfileList { id: zenInstalls;    path: Quickshell.env("HOME") + "/.config/zen/installs.ini" }
    ProfileList { id: zenProfiles;    path: Quickshell.env("HOME") + "/.config/zen/profiles.ini" }
    ProfileList { id: floorpInstalls; path: Quickshell.env("HOME") + "/.config/floorp/installs.ini" }
    ProfileList { id: floorpProfiles; path: Quickshell.env("HOME") + "/.config/floorp/profiles.ini" }

    // Floorp's prefs and chrome from the repo, plus the look's block, written
    // into whichever profile is active; watched, so edits rewrite the copy
    component ProfileSource: FileView {
        property bool ready: false
        preload: true
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: { ready = true; debounce.restart() }
        onLoadFailed: ready = false
    }
    ProfileSource { id: floorpUserJs; path: Quickshell.env("HOME") + "/.config/floorp/singularity/user.js" }
    ProfileSource { id: floorpChrome; path: Quickshell.env("HOME") + "/.config/floorp/singularity/userChrome.css" }
    // Discord's layout sheet, the same way
    ProfileSource { id: discordSheet; path: Quickshell.env("HOME") + "/.config/singularity/discord.css" }


    // Hyprland's state files, read by shared.lua and looks.lua: file name ->
    // its one line. Hyprland read them when it started, so a file's first
    // write only writes; later changes are coalesced (steppers fire once per
    // step) and a config-only reload follows the ones that changed a file.
    readonly property var hyprFiles: ({
        "animations": Settings.animTime + " " + Settings.animWindows + " " + Settings.animWorkspaces,
        // how windows open, close and minimize
        "window-anim": Settings.windowAnim,
        "borders": [Theme.windowBorderActive, Theme.windowBorderInactive].map(hyprColour).join(" "),
        // window corners, rounded like the shell's panels, so its own
        // windows' frames fill Hyprland's clip and every other window matches
        "rounding": String(Theme.windowRadius),
        // the tab bar over grouped windows
        "groupbar": [Settings.tabBar === "accent" ? Theme.accent : Theme.selectedFill, Theme.bar,
                     Settings.tabBar === "accent" ? Theme.textOnAccent : Theme.text, Theme.subtext, Theme.accent]
            .map(c => hyprColour(Qt.rgba(c.r, c.g, c.b, 1))).join(" "),
        // the windows' gap from the screen's edges, which a floating bar keeps too
        "gaps": String(Settings.edgeGap),
        // focused and unfocused opacity, as 0-1 fractions
        "window-opacity": (Settings.focusedOpacity / 100) + " " + (Settings.unfocusedOpacity / 100),
        // the bar's extent at the top (0 at the bottom), for the Notes rule
        "bar-top": String(Theme.barPosition === "top" ? Theme.barExtent : 0),
        // the windows' border width and shadow, from the style
        "window-frame": Theme.windowBorderWidth + " " + Theme.windowShadow,
    })
    // what each file was last written with
    property var hyprWritten: ({})

    function writeHypr() {
        for (const name in hyprFiles) {
            const text = hyprFiles[name] + "\n"
            if (hyprWritten[name] === text) continue
            const reload = name in hyprWritten
            hyprWritten[name] = text
            AtomicFileWrite.write({
                path: root.dir + "/" + name,
                transform: () => text,
                done: status => { if (reload && status === "ok") hyprReload.restart() },
            })
        }
    }

    onHyprFilesChanged: hyprDebounce.restart()
    Timer {
        id: hyprDebounce
        interval: 200
        onTriggered: root.writeHypr()
    }
    Timer {
        id: hyprReload
        interval: 150
        onTriggered: Quickshell.execDetached(["hyprctl", "reload", "config-only"])
    }

    // Cursor and icon themes for Hyprland's login environment (`cursor`:
    // "<theme> <size>", `icons`); the pointer changes live via setcursor, and
    // Hyprland's environment for apps it starts from now on via hl.env.
    function writeCursor(apply) {
        var line = Settings.cursorTheme + " " + Settings.cursorSize
        var sq = s => "'" + String(s).replace(/'/g, "'\\''") + "'"
        var env = Object.entries(Apps.cursorEnv)
            .map(([k, v]) => "hl.env(" + JSON.stringify(k) + ", " + JSON.stringify(v) + ")").join("; ")
        AtomicFileWrite.write({
            path: root.dir + "/cursor",
            transform: () => line + "\n",
            after: apply ? "hyprctl setcursor " + sq(Settings.cursorTheme) + " " + Settings.cursorSize
                + " >/dev/null; hyprctl eval " + sq(env) + " >/dev/null" : "",
        })
        // the XCursor fallback, for apps that read neither gsettings nor
        // XCURSOR_THEME
        var index = "[Icon Theme]\nName=Default\nComment=Default cursor theme\nInherits="
            + Settings.cursorTheme + "\n"
        AtomicFileWrite.write({
            path: Quickshell.env("HOME") + "/.local/share/icons/default/index.theme",
            transform: () => index,
        })
        // GTK on X11 reads no gsettings, and Chromium/Electron there take
        // their pointer from GTK; env.lua puts xdg/ on XDG_CONFIG_DIRS
        var ini = "[Settings]\ngtk-cursor-theme-name=" + Settings.cursorTheme
            + "\ngtk-cursor-theme-size=" + Settings.cursorSize + "\n"
        for (var v of ["gtk-3.0", "gtk-4.0"])
            AtomicFileWrite.write({ path: root.dir + "/xdg/" + v + "/settings.ini", transform: () => ini })
    }
    function writeIcons() {
        var theme = Settings.iconTheme
        AtomicFileWrite.write({ path: root.dir + "/icons", transform: () => theme + "\n" })
    }

    // Stepping the size fires once per step; one setcursor at the end is enough.
    Timer {
        id: cursorDebounce
        interval: 200
        onTriggered: root.writeCursor(true)
    }

    Connections {
        target: Settings
        function onSystemFontFamilyChanged() { debounce.restart() }
        function onCursorThemeChanged() { cursorDebounce.restart(); debounce.restart() }
        function onCursorSizeChanged() { cursorDebounce.restart(); debounce.restart() }
        function onIconThemeChanged() { root.writeIcons(); debounce.restart() }
        function onTerminalOpacityChanged() { debounce.restart() }
    }

    // Plus the first sync. root.dir needn't exist yet: FileView.setText and
    // AtomicFileWrite both create missing parent directories.
    Component.onCompleted: {
        writeHypr()
        writeCursor(false)
        writeIcons()
        debounce.restart()
    }
}
