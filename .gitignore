# stow leftovers
.stow-local-ignore

# editor / os cruft
*.swp
.DS_Store
Thumbs.db

# nvim state that should never be committed
dotfiles/nvim/.config/nvim/lazy-lock.json.bak
dotfiles/nvim/.local/

# alttab-relay is compiled by install.sh from alttab-relay.cpp; the binary
# itself is a build artifact, not a dotfile.
dotfiles/hypr/.config/hypr/alttab-relay

# display-curve, likewise, from display-curve.c
dotfiles/hypr/.config/hypr/display-curve

# Claude Code settings
.claude/

# python bytecode from tools/
__pycache__/

# AtomicFileWrite's temp file, written beside its target -- which, through
# the stowed folders, is inside the repo -- and left behind if the shell dies
# mid-write
*.new

# GTK's bookmarks, written by link.sh with this machine's home directory
# and rewritten by the file manager; lands here when gtk-3.0 is a stowed link
dotfiles/gtk/.config/gtk-3.0/bookmarks

# This machine's own copies of the files Settings edits, made by link.sh
# from the *.defaults.* files in dotfiles/singularity/.config/singularity;
# they land here when hypr is a stowed link
dotfiles/hypr/.config/hypr/hypridle.conf
dotfiles/hypr/.config/hypr/binds.lua
dotfiles/hypr/.config/hypr/hyprlock.conf
