# stow leftovers
.stow-local-ignore

# editor / os cruft
*.swp
.DS_Store
Thumbs.db

# nvim state that should never be committed
dotfiles/nvim/.config/nvim/lazy-lock.json.bak
dotfiles/nvim/.local/

# alttab-relay is compiled by install.sh from alttab-relay.cpp; the binary
# itself is a build artifact, not a dotfile.
dotfiles/hypr/.config/hypr/alttab-relay

# Claude Code settings
.claude/

# python bytecode from tools/
__pycache__/

# AtomicFileWrite's temp file, written beside its target -- which, through
# the stowed folders, is inside the repo -- and left behind if the shell dies
# mid-write
*.new
